# Convergence Play. Both values are public frontend configuration, not server secrets.
# Copy Project URL and publishable key from Supabase Project Settings / API Keys.
VITE_GAMES_SUPABASE_URL=
VITE_GAMES_SUPABASE_PUBLISHABLE_KEY=
# Never place sb_secret_*, service_role, database passwords or host passwords here.
